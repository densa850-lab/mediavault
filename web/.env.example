# Copy to .env.local. NEXT_PUBLIC_* values end up in the browser bundle: never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only (not exposed to the browser): where the website's /api/auth/* routes reach the API.
# Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
API_INTERNAL_BASE_URL=http://localhost:8000
# Server-only. Number of reverse proxies in front of this server that APPEND the client address to
# X-Forwarded-For. 0/unset = the browser's X-Forwarded-For is never trusted and no client IP is
# passed to the API. Set it (e.g. 1) only when such a proxy really is in front.
WEB_TRUSTED_PROXY_HOPS=0
