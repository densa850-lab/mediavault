# Copy to .env.local. NEXT_PUBLIC_* values end up in the browser bundle: never put secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-only (not exposed to the browser): where the website's /api/auth/* routes reach the API.
# Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
API_INTERNAL_BASE_URL=http://localhost:8000
