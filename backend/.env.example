# MediaVault local development settings.
# Copy to .env (never commit .env). These are LOCAL-ONLY values; real staging/production
# secrets live in each environment's secret store, never in git.

# --- Docker services (infrastructure/docker/compose.dev.yml) ---
POSTGRES_USER=mediavault
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=mediavault
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333

# --- Backend (backend/ reads this file too) ---
# staging/production: DATABASE_URL is required and CORS_ALLOW_ORIGINS must be https:// origins only.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://mediavault:change-me-local-only@localhost:5432/mediavault
# Used only by `uv run pytest` for tests that need a real database.
TEST_DATABASE_URL=postgresql+psycopg://mediavault:change-me-local-only@localhost:5432/mediavault_test
CORS_ALLOW_ORIGINS=http://localhost:3000
# Auth. Leave JWT_SECRET unset locally (a development-only default is used in development/test).
# staging/production: REQUIRED, at least 32 random characters, from the secret store. Never commit it.
# JWT_SECRET=
# Concurrent-refresh grace in seconds (0..60, 0 = strict single use). See ARCHITECTURE.md.
REFRESH_REUSE_GRACE_S=10
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For (e.g. the website server). Empty = none.
AUTH_TRUSTED_PROXIES=
